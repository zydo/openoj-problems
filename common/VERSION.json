{
  "schema": 1,
  "version": 2,
  "types": [
    "ListNode",
    "TreeNode",
    "Node",
    "QuadNode",
    "NestedInteger",
    "NodeWithNext",
    "MultiListNode"
  ],
  "wire": {
    "ListNode": {
      "val": "int",
      "next": "ListNode | null"
    },
    "TreeNode": {
      "val": "int",
      "left": "TreeNode | null",
      "right": "TreeNode | null"
    },
    "Node": {
      "val": "int",
      "children": "list[Node]"
    },
    "QuadNode": {
      "val": "bool",
      "isLeaf": "bool",
      "topLeft": "QuadNode | null",
      "topRight": "QuadNode | null",
      "bottomLeft": "QuadNode | null",
      "bottomRight": "QuadNode | null"
    },
    "NestedInteger": {
      "hold": "int | list[NestedInteger]"
    },
    "NodeWithNext": {
      "val": "int",
      "left": "NodeWithNext | null",
      "right": "NodeWithNext | null",
      "next": "NodeWithNext | null",
      "parent": "NodeWithNext | null"
    },
    "MultiListNode": {
      "val": "int",
      "prev": "MultiListNode | null",
      "next": "MultiListNode | null",
      "child": "MultiListNode | null"
    }
  }
}
