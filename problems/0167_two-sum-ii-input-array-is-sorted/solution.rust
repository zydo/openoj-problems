impl Solution {
    pub fn two_sum(numbers: Vec<i32>, target: i32) -> Vec<i32> {
        let (mut left, mut right) = (0usize, numbers.len() - 1);
        while left < right {
            let total = numbers[left] + numbers[right];
            if total == target {
                return vec![left as i32 + 1, right as i32 + 1];
            } else if total < target {
                left += 1;
            } else {
                right -= 1;
            }
        }
        Vec::new()
    }
}
