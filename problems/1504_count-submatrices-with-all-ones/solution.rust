impl Solution {
    pub fn num_submat(mat: Vec<Vec<i32>>) -> i32 {
        let m = mat.len();
        let n = if m > 0 { mat[0].len() } else { 0 };
        let mut total: i32 = 0;
        let mut height = vec![0i32; n];
        for r in 0..m {
            for c in 0..n {
                if mat[r][c] == 1 {
                    height[c] += 1;
                } else {
                    height[c] = 0;
                }
            }
            for left in 0..n {
                let mut min_h = height[left];
                for right in left..n {
                    if height[right] < min_h {
                        min_h = height[right];
                    }
                    total += min_h;
                }
            }
        }
        total
    }
}
