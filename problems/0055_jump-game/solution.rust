impl Solution {
    pub fn can_jump(nums: Vec<i32>) -> bool {
        let mut farthest = 0i32;
        let last = nums.len() as i32 - 1;
        for (index, &reach) in nums.iter().enumerate() {
            let index = index as i32;
            if index > farthest {
                return false;
            }
            if index + reach > farthest {
                farthest = index + reach;
            }
            if farthest >= last {
                return true;
            }
        }
        true
    }
}
