impl Solution {
    pub fn earliest_full_bloom(plant_time: Vec<i32>, grow_time: Vec<i32>) -> i32 {
        let mut idx: Vec<usize> = (0..plant_time.len()).collect();
        idx.sort_by(|&a, &b| grow_time[b].cmp(&grow_time[a]));
        let mut best = 0;
        let mut prefix = 0;
        for &i in &idx {
            prefix += plant_time[i];
            best = best.max(prefix + grow_time[i]);
        }
        best
    }
}
