impl Solution {
    pub fn minimum_length_encoding(words: Vec<String>) -> i32 {
        use std::collections::HashSet;
        let mut keep: HashSet<&str> = words.iter().map(|w| w.as_str()).collect();
        for w in &words {
            let b = w.as_bytes();
            for k in 1..b.len() {
                keep.remove(&w[k..]);
            }
        }
        let mut total: i32 = 0;
        for w in keep {
            total += w.len() as i32 + 1;
        }
        total
    }
}
