use std::collections::HashSet;

impl Solution {
    fn is_valid(s: &[u8]) -> bool {
        let mut count = 0i32;
        for &ch in s {
            if ch == b'(' {
                count += 1;
            } else if ch == b')' {
                count -= 1;
                if count < 0 {
                    return false;
                }
            }
        }
        count == 0
    }

    pub fn remove_invalid_parentheses(s: String) -> Vec<String> {
        let bytes = s.into_bytes();
        let mut level: HashSet<Vec<u8>> = HashSet::new();
        level.insert(bytes);
        loop {
            let mut valid: Vec<String> = level
                .iter()
                .filter(|item| Solution::is_valid(item))
                .map(|item| String::from_utf8(item.clone()).unwrap())
                .collect();
            if !valid.is_empty() {
                valid.sort();
                return valid;
            }
            let mut next: HashSet<Vec<u8>> = HashSet::new();
            for item in &level {
                for i in 0..item.len() {
                    let ch = item[i];
                    if ch == b'(' || ch == b')' {
                        let mut cand = item.clone();
                        cand.remove(i);
                        next.insert(cand);
                    }
                }
            }
            level = next;
        }
    }
}
