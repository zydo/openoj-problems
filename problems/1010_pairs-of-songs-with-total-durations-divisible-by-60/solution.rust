impl Solution {
    pub fn num_pairs_divisible_by_60(time: Vec<i32>) -> i32 {
        let mut counts = [0i64; 60];
        let mut total: i64 = 0;
        for &duration in time.iter() {
            let remainder = (duration % 60) as usize;
            total += counts[(60 - remainder as i32) as usize % 60];
            counts[remainder] += 1;
        }
        total as i32
    }
}
