impl Solution {
    pub fn reaching_points(sx: i32, sy: i32, tx: i32, ty: i32) -> bool {
        let (mut tx, mut ty) = (tx, ty);
        while tx >= sx && ty >= sy {
            if tx == sx && ty == sy {
                return true;
            }
            if tx == sx {
                return (ty - sy) % sx == 0;
            }
            if ty == sy {
                return (tx - sx) % sy == 0;
            }
            if tx > ty {
                tx %= ty;
            } else {
                ty %= tx;
            }
        }
        false
    }
}
