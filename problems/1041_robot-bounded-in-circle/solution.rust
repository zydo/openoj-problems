impl Solution {
    pub fn is_robot_bounded(instructions: String) -> bool {
        let (mut x, mut y) = (0i32, 0i32);
        let (mut dx, mut dy) = (0i32, 1i32); // north
        for ch in instructions.bytes() {
            match ch {
                b'G' => {
                    x += dx;
                    y += dy;
                }
                b'L' => {
                    let ndx = -dy;
                    let ndy = dx;
                    dx = ndx;
                    dy = ndy;
                }
                _ => {
                    // 'R'
                    let ndx = dy;
                    let ndy = -dx;
                    dx = ndx;
                    dy = ndy;
                }
            }
        }
        (x == 0 && y == 0) || !(dx == 0 && dy == 1)
    }
}
