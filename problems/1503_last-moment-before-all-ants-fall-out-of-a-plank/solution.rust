impl Solution {
    pub fn get_last_moment(n: i32, left: Vec<i32>, right: Vec<i32>) -> i32 {
        let mut best = 0;
        for &position in &left {
            best = best.max(position);
        }
        for &position in &right {
            best = best.max(n - position);
        }
        best
    }
}
