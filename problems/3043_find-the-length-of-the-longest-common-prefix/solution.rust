use std::collections::HashSet;

impl Solution {
    pub fn longest_common_prefix(arr1: Vec<i32>, arr2: Vec<i32>) -> i32 {
        let mut prefixes: HashSet<i32> = HashSet::new();
        for &x in &arr1 {
            let mut v: i32 = 0;
            for c in x.to_string().bytes() {
                v = v * 10 + (c - b'0') as i32;
                prefixes.insert(v);
            }
        }
        let mut best: i32 = 0;
        for &y in &arr2 {
            let mut v: i32 = 0;
            let mut len: i32 = 0;
            for c in y.to_string().bytes() {
                v = v * 10 + (c - b'0') as i32;
                len += 1;
                if prefixes.contains(&v) {
                    if len > best {
                        best = len;
                    }
                } else {
                    break;
                }
            }
        }
        best
    }
}
