impl Solution {
    pub fn max_profit(prices: Vec<i32>) -> i32 {
        let (mut hold, mut sold, mut rest) = (-1_000_000_000, 0, 0);
        for &price in prices.iter() {
            let prev_sold = sold;
            hold = hold.max(rest - price);
            sold = hold + price;
            rest = rest.max(prev_sold);
        }
        sold.max(rest)
    }
}
