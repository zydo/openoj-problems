impl Solution {
    pub fn matrix_median(grid: Vec<Vec<i32>>) -> i32 {
        let m = grid.len();
        let n = grid[0].len();
        let need = (m * n) / 2 + 1;
        let mut lo = i32::MAX;
        let mut hi = i32::MIN;
        for row in &grid {
            lo = lo.min(row[0]);
            hi = hi.max(row[n - 1]);
        }
        let count_le = |x: i32| -> usize {
            grid.iter()
                .map(|row| row.partition_point(|&v| v <= x))
                .sum()
        };
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if count_le(mid) >= need {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo
    }
}
