impl Solution {
    pub fn minimum_difference(nums: Vec<i32>, k: i32) -> i32 {
        let mut best = (nums[0] - k).abs();
        let mut current: Vec<i32> = vec![0];
        for &value in &nums {
            let mut nxt: Vec<i32> = vec![value];
            for &prev in &current {
                nxt.push(prev | value);
            }
            nxt.sort_unstable();
            nxt.dedup();
            current = nxt;
            for &x in &current {
                let diff = (x - k).abs();
                if diff < best {
                    best = diff;
                }
            }
        }
        best
    }
}
