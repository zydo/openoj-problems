impl Solution {
    pub fn missing_element(nums: Vec<i32>, k: i32) -> i32 {
        let n = nums.len();
        let missing = |i: usize| nums[i] - nums[0] - i as i32;
        if missing(n - 1) < k {
            return nums[n - 1] + (k - missing(n - 1));
        }
        let (mut lo, mut hi) = (0usize, n - 1);
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if missing(mid) >= k {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        nums[lo - 1] + (k - missing(lo - 1))
    }
}
