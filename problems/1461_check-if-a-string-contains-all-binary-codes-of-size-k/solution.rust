use std::collections::HashSet;

impl Solution {
    pub fn has_all_codes(s: String, k: i32) -> bool {
        let k = k as usize;
        let need = 1usize << k;
        let bytes = s.as_bytes();
        if bytes.len() < k {
            return false;
        }
        let mut seen: HashSet<&[u8]> = HashSet::new();
        for i in 0..=(bytes.len() - k) {
            seen.insert(&bytes[i..i + k]);
            if seen.len() == need {
                return true;
            }
        }
        seen.len() == need
    }
}
