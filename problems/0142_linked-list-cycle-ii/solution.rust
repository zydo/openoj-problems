impl Solution {
    pub fn detect_cycle(values: Vec<i32>, pos: i32) -> i32 {
        if values.is_empty() {
            return -1;
        }
        const NIL: usize = usize::MAX;
        let mut next = vec![NIL; values.len()];
        for i in 0..values.len() - 1 {
            next[i] = i + 1;
        }
        if pos != -1 {
            next[values.len() - 1] = pos as usize;
        }
        // Floyd's tortoise and hare over the node graph (indices as links).
        let mut slow = 0usize;
        let mut fast = 0usize;
        loop {
            let step1 = next[fast];
            if step1 == NIL {
                return -1;
            }
            let step2 = next[step1];
            if step2 == NIL {
                return -1;
            }
            slow = next[slow];
            fast = step2;
            if slow == fast {
                // Phase 2: one pointer back at the head; both advance one
                // step and meet exactly at the cycle-entry node.
                let mut finder = 0usize;
                while finder != slow {
                    finder = next[finder];
                    slow = next[slow];
                }
                return finder as i32;
            }
        }
    }
}
