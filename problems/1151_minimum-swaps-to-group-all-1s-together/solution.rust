impl Solution {
    pub fn min_swaps(data: Vec<i32>) -> i32 {
        let ones: usize = data.iter().map(|&v| v as usize).sum();
        if ones <= 1 {
            return 0;
        }
        let mut zeros = 0;
        for i in 0..ones {
            if data[i] == 0 {
                zeros += 1;
            }
        }
        let mut best = zeros;
        for i in ones..data.len() {
            zeros += (1 - data[i] as i32) - (1 - data[i - ones] as i32);
            if zeros < best {
                best = zeros;
            }
        }
        best
    }
}
