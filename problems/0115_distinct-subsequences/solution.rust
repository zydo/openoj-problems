impl Solution {
    pub fn num_distinct(s: String, t: String) -> i32 {
        let s = s.as_bytes();
        let t = t.as_bytes();
        let m = t.len();
        let mut dp = vec![0i64; m + 1];
        dp[0] = 1;
        for &ch in s {
            for j in (1..=m).rev() {
                if t[j - 1] == ch {
                    dp[j] = dp[j].wrapping_add(dp[j - 1]);
                }
            }
        }
        dp[m] as i32
    }
}
