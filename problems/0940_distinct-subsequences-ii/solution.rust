impl Solution {
    pub fn distinct_subseq_ii(s: String) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let s = s.as_bytes();
        let n = s.len();
        let mut dp = vec![0i64; n + 1];
        dp[0] = 1;
        let mut last = [-1i64; 26];
        for i in 1..=n {
            let c = (s[i - 1] - b'a') as usize;
            dp[i] = dp[i - 1] * 2 % MOD;
            if last[c] >= 0 {
                dp[i] = (dp[i] - dp[last[c] as usize] + MOD) % MOD;
            }
            last[c] = (i - 1) as i64;
        }
        ((dp[n] - 1 + MOD) % MOD) as i32
    }
}
