impl Solution {
    pub fn can_see_persons_count(heights: Vec<i32>) -> Vec<i32> {
        let n = heights.len();
        let mut answer = vec![0i32; n];
        let mut stack: Vec<i32> = Vec::new();
        for i in (0..n).rev() {
            let mut seen = 0;
            while let Some(&top) = stack.last() {
                if top < heights[i] {
                    stack.pop();
                    seen += 1;
                } else {
                    break;
                }
            }
            if !stack.is_empty() {
                seen += 1;
            }
            answer[i] = seen;
            stack.push(heights[i]);
        }
        answer
    }
}
