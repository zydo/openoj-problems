impl Solution {
    pub fn calculate_minimum_hp(dungeon: Vec<Vec<i32>>) -> i32 {
        let m = dungeon.len();
        let n = dungeon[0].len();
        let inf = i32::MAX / 2;
        let mut need = vec![vec![inf; n + 1]; m + 1];
        need[m][n - 1] = 1;
        for i in (0..m).rev() {
            for j in (0..n).rev() {
                let best_next = need[i + 1][j].min(need[i][j + 1]);
                need[i][j] = 1.max(best_next - dungeon[i][j]);
            }
        }
        need[0][0]
    }
}
