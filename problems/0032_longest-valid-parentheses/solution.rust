impl Solution {
    pub fn longest_valid_parentheses(s: String) -> i32 {
        let s = s.as_bytes();
        let mut stack: Vec<i32> = Vec::with_capacity(s.len() + 1);
        stack.push(-1);
        let mut best = 0;
        for (i, &ch) in s.iter().enumerate() {
            if ch == b'(' {
                stack.push(i as i32);
            } else {
                stack.pop();
                if stack.is_empty() {
                    stack.push(i as i32);
                } else {
                    let len = i as i32 - *stack.last().unwrap();
                    if len > best {
                        best = len;
                    }
                }
            }
        }
        best
    }
}
