impl Solution {
    pub fn predict_the_winner(nums: Vec<i32>) -> bool {
        let n = nums.len();
        let mut dp = nums.clone();
        for length in 2..=n {
            for i in 0..=(n - length) {
                let j = i + length - 1;
                dp[i] = (nums[i] - dp[i + 1]).max(nums[j] - dp[i]);
            }
        }
        dp[0] >= 0
    }
}
