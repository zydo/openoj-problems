impl Solution {
    pub fn min_cost_climbing_stairs(cost: Vec<i32>) -> i32 {
        let (mut prev2, mut prev1) = (0i64, 0i64);
        for &c in &cost {
            let cur = c as i64 + prev1.min(prev2);
            prev2 = prev1;
            prev1 = cur;
        }
        prev1.min(prev2) as i32
    }
}
