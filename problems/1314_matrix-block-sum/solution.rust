impl Solution {
    pub fn matrix_block_sum(mat: Vec<Vec<i32>>, k: i32) -> Vec<Vec<i32>> {
        let m = mat.len();
        let n = mat[0].len();
        let mut prefix = vec![vec![0i64; n + 1]; m + 1];
        for i in 0..m {
            for j in 0..n {
                prefix[i + 1][j + 1] =
                    prefix[i][j + 1] + prefix[i + 1][j] - prefix[i][j] + mat[i][j] as i64;
            }
        }
        let mut answer = vec![vec![0i32; n]; m];
        for i in 0..m {
            for j in 0..n {
                let r1 = i.saturating_sub(k as usize);
                let r2 = std::cmp::min(m, i + k as usize + 1);
                let c1 = j.saturating_sub(k as usize);
                let c2 = std::cmp::min(n, j + k as usize + 1);
                answer[i][j] =
                    (prefix[r2][c2] - prefix[r1][c2] - prefix[r2][c1] + prefix[r1][c1]) as i32;
            }
        }
        answer
    }
}
