impl Solution {
    pub fn longest_ones(nums: Vec<i32>, k: i32) -> i32 {
        let mut left = 0usize;
        let mut zeros = 0i32;
        let mut best = 0usize;
        for (right, &value) in nums.iter().enumerate() {
            if value == 0 {
                zeros += 1;
            }
            while zeros > k {
                if nums[left] == 0 {
                    zeros -= 1;
                }
                left += 1;
            }
            if right - left + 1 > best {
                best = right - left + 1;
            }
        }
        best as i32
    }
}
