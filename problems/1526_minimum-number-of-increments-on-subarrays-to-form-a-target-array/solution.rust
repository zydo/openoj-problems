impl Solution {
    pub fn min_number_operations(target: Vec<i32>) -> i32 {
        let mut ops: i64 = target[0] as i64;
        for i in 1..target.len() {
            if target[i] > target[i - 1] {
                ops += (target[i] - target[i - 1]) as i64;
            }
        }
        ops as i32
    }
}
