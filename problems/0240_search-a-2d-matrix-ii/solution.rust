impl Solution {
    pub fn search_matrix(matrix: Vec<Vec<i32>>, target: i32) -> bool {
        if matrix.is_empty() || matrix[0].is_empty() {
            return false;
        }
        let mut row = 0usize;
        let mut col = matrix[0].len() as isize - 1;
        while row < matrix.len() && col >= 0 {
            let value = matrix[row][col as usize];
            if value == target {
                return true;
            }
            if value > target {
                col -= 1;
            } else {
                row += 1;
            }
        }
        false
    }
}
