impl Solution {
    pub fn count_special_subsequences(nums: Vec<i32>) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let (mut f0, mut f1, mut f2) = (0i64, 0i64, 0i64);
        for &x in &nums {
            if x == 0 {
                f0 = (f0 * 2 + 1) % MOD;
            } else if x == 1 {
                f1 = (f1 * 2 + f0) % MOD;
            } else {
                f2 = (f2 * 2 + f1) % MOD;
            }
        }
        f2 as i32
    }
}
