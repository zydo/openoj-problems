impl Solution {
    pub fn count_special_numbers(n: i64) -> i32 {
        fn perm(a: i64, k: i64) -> i64 {
            let mut p: i64 = 1;
            for i in 0..k {
                p *= a - i;
            }
            p
        }

        let s = n.to_string();
        let digits: Vec<i64> = s.bytes().map(|b| (b - b'0') as i64).collect();
        let l = digits.len() as i64;
        let mut total: i64 = 0;
        for k in 1..l {
            total += 9 * perm(9, k - 1);
        }
        let mut used: u32 = 0;
        let mut broke = false;
        for i in 0..digits.len() {
            let d = digits[i];
            let lo: i64 = if i == 0 { 1 } else { 0 };
            let mut x = lo;
            while x < d {
                if (used >> x) & 1 == 0 {
                    total += perm(10 - (i as i64 + 1), l - i as i64 - 1);
                }
                x += 1;
            }
            if (used >> d) & 1 == 1 {
                broke = true;
                break;
            }
            used |= 1 << d;
        }
        if !broke {
            total += 1;
        }
        total as i32
    }
}
