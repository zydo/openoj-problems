impl Solution {
    pub fn shortest_sequence(rolls: Vec<i32>, k: i32) -> i32 {
        let mut seen = std::collections::HashSet::new();
        let mut answer = 1i32;
        for r in rolls {
            seen.insert(r);
            if seen.len() == k as usize {
                answer += 1;
                seen.clear();
            }
        }
        answer
    }
}
