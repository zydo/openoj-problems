impl Solution {
    pub fn xor_all_nums(nums1: Vec<i32>, nums2: Vec<i32>) -> i32 {
        let mut answer = 0;
        if nums2.len() % 2 == 1 {
            for &value in &nums1 {
                answer ^= value;
            }
        }
        if nums1.len() % 2 == 1 {
            for &value in &nums2 {
                answer ^= value;
            }
        }
        answer
    }
}
