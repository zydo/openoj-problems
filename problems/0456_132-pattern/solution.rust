impl Solution {
    pub fn find132pattern(nums: Vec<i32>) -> bool {
        if nums.len() < 3 {
            return false;
        }
        let mut stack: Vec<i32> = Vec::new();
        let mut third: i64 = i64::MIN;
        for &value in nums.iter().rev() {
            if (value as i64) < third {
                return true;
            }
            while let Some(&top) = stack.last() {
                if top < value {
                    third = top as i64;
                    stack.pop();
                } else {
                    break;
                }
            }
            stack.push(value);
        }
        false
    }
}
