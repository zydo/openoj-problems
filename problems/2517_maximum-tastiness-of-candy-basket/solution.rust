impl Solution {
    pub fn maximum_tastiness(price: Vec<i32>, k: i32) -> i32 {
        let mut p = price;
        p.sort_unstable();
        let n = p.len();
        let feasible = |x: i32| -> bool {
            let mut count = 1i64;
            let mut last = p[0];
            for i in 1..n {
                if p[i] - last >= x {
                    count += 1;
                    last = p[i];
                }
            }
            count >= k as i64
        };
        let (mut lo, mut hi) = (0i32, p[n - 1] - p[0]);
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            if feasible(mid) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}
