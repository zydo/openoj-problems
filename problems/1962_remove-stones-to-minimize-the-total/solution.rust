use std::collections::BinaryHeap;

impl Solution {
    pub fn min_stone_sum(piles: Vec<i32>, k: i32) -> i32 {
        let mut heap: BinaryHeap<i32> = BinaryHeap::from(piles);
        for _ in 0..k {
            let top = *heap.peek().unwrap();
            if top == 1 {
                break;
            }
            heap.pop();
            heap.push(top - top / 2);
        }
        heap.iter().sum()
    }
}
