impl Solution {
    pub fn maximal_square(matrix: Vec<Vec<String>>) -> i32 {
        let m = matrix.len();
        let n = matrix[0].len();
        let mut best = 0;
        let mut prev = vec![0i32; n + 1];
        for i in 0..m {
            let mut curr = vec![0i32; n + 1];
            for j in 0..n {
                if matrix[i][j] == "1" {
                    curr[j + 1] = prev[j].min(prev[j + 1]).min(curr[j]) + 1;
                    best = best.max(curr[j + 1]);
                }
            }
            prev = curr;
        }
        best * best
    }
}
