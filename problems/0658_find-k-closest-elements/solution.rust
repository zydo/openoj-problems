impl Solution {
    pub fn find_closest_elements(arr: Vec<i32>, k: i32, x: i32) -> Vec<i32> {
        let k = k as usize;
        let mut lo = 0usize;
        let mut hi = arr.len() - k;
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if x - arr[mid] > arr[mid + k] - x {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        arr[lo..lo + k].to_vec()
    }
}
