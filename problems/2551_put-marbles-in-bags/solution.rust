impl Solution {
    pub fn put_marbles(weights: Vec<i32>, k: i32) -> i64 {
        if k == 1 {
            return 0;
        }
        let n = weights.len();
        let mut adj: Vec<i64> = Vec::with_capacity(n - 1);
        for i in 0..n - 1 {
            adj.push(weights[i] as i64 + weights[i + 1] as i64);
        }
        adj.sort_unstable();
        let m = (k - 1) as usize;
        let mut ans: i64 = 0;
        for i in 0..m {
            ans += adj[n - 2 - i] - adj[i];
        }
        ans
    }
}
