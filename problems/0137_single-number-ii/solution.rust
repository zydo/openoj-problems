impl Solution {
    pub fn single_number(nums: Vec<i32>) -> i32 {
        let mut result: u32 = 0;
        for i in 0..32 {
            let mut count = 0;
            for &value in &nums {
                count += ((value >> i) & 1) as usize;
            }
            if count % 3 != 0 {
                result |= 1u32 << i;
            }
        }
        result as i32
    }
}
