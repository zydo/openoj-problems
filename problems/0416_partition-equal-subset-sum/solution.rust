impl Solution {
    pub fn can_partition(nums: Vec<i32>) -> bool {
        let total: i64 = nums.iter().map(|&v| v as i64).sum();
        if total % 2 != 0 {
            return false;
        }
        let target = (total / 2) as usize;
        let mut dp = vec![false; target + 1];
        dp[0] = true;
        for &v in &nums {
            let v = v as usize;
            if v == 0 {
                continue;
            }
            for j in (v..=target).rev() {
                if dp[j - v] {
                    dp[j] = true;
                }
            }
            if dp[target] {
                return true;
            }
        }
        dp[target]
    }
}
