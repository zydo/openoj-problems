impl Solution {
    pub fn first_day_been_in_all_rooms(next_visit: Vec<i32>) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = next_visit.len();
        let mut f = vec![0i64; n];
        for i in 1..n {
            let t = 2 * f[i - 1] - f[next_visit[i - 1] as usize] + 2;
            f[i] = t.rem_euclid(MOD);
        }
        f[n - 1] as i32
    }
}
