impl Solution {
    pub fn single_non_duplicate(nums: Vec<i32>) -> i32 {
        let mut lo = 0usize;
        let mut hi = nums.len() - 1;
        while lo < hi {
            let mut mid = (lo + hi) / 2;
            if mid % 2 == 1 {
                mid -= 1;
            }
            if nums[mid] == nums[mid + 1] {
                lo = mid + 2;
            } else {
                hi = mid;
            }
        }
        nums[lo]
    }
}
