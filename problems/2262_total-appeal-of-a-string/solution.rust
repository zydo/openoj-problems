impl Solution {
    pub fn appeal_sum(s: String) -> i64 {
        let mut last = [-1i64; 26];
        let mut total: i64 = 0;
        let mut current: i64 = 0;
        for (i, b) in s.bytes().enumerate() {
            let c = (b - b'a') as usize;
            current += i as i64 - last[c];
            last[c] = i as i64;
            total += current;
        }
        total
    }
}
