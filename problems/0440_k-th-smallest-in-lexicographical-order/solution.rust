impl Solution {
    pub fn find_kth_number(n: i32, k: i32) -> i32 {
        let n = n as i64;
        let mut cur: i64 = 1;
        let mut kk: i64 = k as i64 - 1;
        while kk > 0 {
            let steps = count_steps(n, cur, cur + 1);
            if steps <= kk {
                cur += 1;
                kk -= steps;
            } else {
                cur *= 10;
                kk -= 1;
            }
        }
        cur as i32
    }
}

fn count_steps(n: i64, mut n1: i64, mut n2: i64) -> i64 {
    let mut steps: i64 = 0;
    while n1 <= n {
        steps += (n + 1).min(n2) - n1;
        n1 *= 10;
        n2 *= 10;
    }
    steps
}
