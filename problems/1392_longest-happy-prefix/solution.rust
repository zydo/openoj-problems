impl Solution {
    pub fn longest_prefix(s: String) -> String {
        let b = s.as_bytes();
        let n = b.len();
        let mut pi = vec![0usize; n];
        let mut j = 0usize;
        for i in 1..n {
            while j > 0 && b[i] != b[j] {
                j = pi[j - 1];
            }
            if b[i] == b[j] {
                j += 1;
            }
            pi[i] = j;
        }
        if n == 0 {
            String::new()
        } else {
            s[..pi[n - 1]].to_string()
        }
    }
}
