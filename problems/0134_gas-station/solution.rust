impl Solution {
    pub fn can_complete_circuit(gas: Vec<i32>, cost: Vec<i32>) -> i32 {
        let mut total: i64 = 0;
        let mut tank: i64 = 0;
        let mut start: i32 = 0;
        for i in 0..gas.len() {
            let diff = gas[i] as i64 - cost[i] as i64;
            total += diff;
            tank += diff;
            if tank < 0 {
                start = i as i32 + 1;
                tank = 0;
            }
        }
        if total >= 0 {
            start
        } else {
            -1
        }
    }
}
