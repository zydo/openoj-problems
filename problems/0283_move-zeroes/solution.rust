impl Solution {
    pub fn move_zeroes(nums: Vec<i32>) -> Vec<i32> {
        let mut nums = nums;
        let mut slow = 0;
        for fast in 0..nums.len() {
            if nums[fast] != 0 {
                nums.swap(slow, fast);
                slow += 1;
            }
        }
        nums
    }
}
