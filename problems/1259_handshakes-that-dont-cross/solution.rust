impl Solution {
    pub fn number_of_ways(num_people: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let m = (num_people / 2) as usize;
        let mut catalan = vec![0i64; m + 1];
        catalan[0] = 1;
        for i in 1..=m {
            let mut total: i64 = 0;
            for j in 0..i {
                total = (total + catalan[j] * catalan[i - 1 - j]) % MOD;
            }
            catalan[i] = total;
        }
        catalan[m] as i32
    }
}
