impl Solution {
    pub fn is_zero_array(nums: Vec<i32>, queries: Vec<Vec<i32>>) -> bool {
        let n = nums.len();
        let mut diff = vec![0i64; n + 1];
        for q in &queries {
            diff[q[0] as usize] += 1;
            diff[q[1] as usize + 1] -= 1;
        }
        let mut coverage: i64 = 0;
        for i in 0..n {
            coverage += diff[i];
            if coverage < nums[i] as i64 {
                return false;
            }
        }
        true
    }
}
