impl Solution {
    pub fn min_distance(word1: String, word2: String) -> i32 {
        let a = word1.as_bytes();
        let b = word2.as_bytes();
        let la = a.len();
        let lb = b.len();
        let mut dp = vec![vec![0i32; lb + 1]; la + 1];
        for i in 1..=la {
            for j in 1..=lb {
                if a[i - 1] == b[j - 1] {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                } else {
                    dp[i][j] = dp[i - 1][j].max(dp[i][j - 1]);
                }
            }
        }
        (la + lb - 2 * dp[la][lb] as usize) as i32
    }
}
