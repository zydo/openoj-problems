impl Solution {
    pub fn sort_colors(nums: Vec<i32>) -> Vec<i32> {
        let mut nums = nums;
        let mut counts = [0i32; 3];
        for &value in &nums {
            counts[value as usize] += 1;
        }
        let mut index = 0;
        for color in 0..3 {
            for _ in 0..counts[color as usize] {
                nums[index] = color;
                index += 1;
            }
        }
        nums
    }
}
