impl Solution {
    pub fn count_submatrices(grid: Vec<Vec<i32>>, k: i32) -> i32 {
        let rows = grid.len();
        let cols = grid[0].len();
        let mut col_sums = vec![0i64; cols];
        let mut count: i32 = 0;
        for i in 0..rows {
            let mut prefix: i64 = 0;
            for j in 0..cols {
                col_sums[j] += grid[i][j] as i64;
                prefix += col_sums[j];
                if prefix > k as i64 {
                    break;
                }
                count += 1;
            }
        }
        count
    }
}
