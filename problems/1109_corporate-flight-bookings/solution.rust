impl Solution {
    pub fn corp_flight_bookings(bookings: Vec<Vec<i32>>, n: i32) -> Vec<i32> {
        let n = n as usize;
        let mut diff = vec![0i32; n + 1];
        for b in &bookings {
            diff[(b[0] - 1) as usize] += b[2];
            diff[b[1] as usize] -= b[2];
        }
        let mut answer = Vec::with_capacity(n);
        let mut running = 0i32;
        for i in 0..n {
            running += diff[i];
            answer.push(running);
        }
        answer
    }
}
