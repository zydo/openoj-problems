impl Solution {
    pub fn max_score(points: Vec<i32>, m: i32) -> i64 {
        let n = points.len();
        let m = m as i64;
        let feasible = |target: i64| -> bool {
            let mut moves: i64 = 0;
            let mut prev: i64 = 0;
            for i in 0..n {
                let gp = points[i] as i64;
                let remain = (target + gp - 1) / gp - prev;
                if remain >= 1 {
                    prev = remain - 1;
                    moves += 2 * remain - 1;
                } else if i != n - 1 {
                    prev = 0;
                    moves += 1;
                }
                if moves > m {
                    return false;
                }
            }
            moves <= m
        };
        let mut hi: i64 = 0;
        for &p in &points {
            let v = (p as i64) * m;
            if v > hi {
                hi = v;
            }
        }
        let mut lo: i64 = 0;
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            if feasible(mid) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}
