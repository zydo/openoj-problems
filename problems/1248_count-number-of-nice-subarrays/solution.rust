impl Solution {
    pub fn number_of_subarrays(nums: Vec<i32>, k: i32) -> i32 {
        let n = nums.len();
        let mut counts = vec![0i64; n + 1];
        counts[0] = 1;
        let mut odds = 0usize;
        let mut result: i64 = 0;
        for &x in &nums {
            odds += (x & 1) as usize;
            if odds as i64 - k as i64 >= 0 {
                result += counts[odds - k as usize];
            }
            counts[odds] += 1;
        }
        result as i32
    }
}
