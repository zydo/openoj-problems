impl Solution {
    fn zeta(x: i64) -> i64 {
        let mut count = 0i64;
        let mut p = 5i64;
        while p <= x {
            count += x / p;
            p *= 5;
        }
        count
    }

    pub fn preimage_size_f_z_f(k: i32) -> i32 {
        let k = k as i64;
        let mut lo = 0i64;
        let mut hi = 5 * (k + 1) + 10;
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if Self::zeta(mid) < k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if Self::zeta(lo) == k {
            5
        } else {
            0
        }
    }
}
