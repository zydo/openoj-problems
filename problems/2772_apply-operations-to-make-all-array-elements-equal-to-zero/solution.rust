impl Solution {
    pub fn check_array(nums: Vec<i32>, k: i32) -> bool {
        let n = nums.len();
        let k = k as usize;
        let mut diff = vec![0i64; n + 1];
        let mut running: i64 = 0;
        for i in 0..n {
            running += diff[i];
            let cur = nums[i] as i64 - running;
            if cur < 0 {
                return false;
            }
            if cur == 0 {
                continue;
            }
            if i + k > n {
                return false;
            }
            running += cur;
            diff[i + k] -= cur;
        }
        true
    }
}
