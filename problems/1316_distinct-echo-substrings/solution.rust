impl Solution {
    pub fn distinct_echo_substrings(text: String) -> i32 {
        let b = text.as_bytes();
        let n = b.len();
        let mut seen: std::collections::HashSet<&str> = std::collections::HashSet::new();
        for half in 1..=n / 2 {
            for i in 0..n - 2 * half + 1 {
                if &b[i..i + half] == &b[i + half..i + 2 * half] {
                    seen.insert(&text[i..i + 2 * half]);
                }
            }
        }
        seen.len() as i32
    }
}
