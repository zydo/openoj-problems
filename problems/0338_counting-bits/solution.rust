impl Solution {
    pub fn count_bits(n: i32) -> Vec<i32> {
        let n = n as usize;
        let mut ans = vec![0i32; n + 1];
        // i >> 1 drops the low bit, so its popcount is already computed;
        // i & 1 adds the dropped bit back. Ascending order keeps it ready.
        for i in 1..=n {
            ans[i] = ans[i >> 1] + (i as i32 & 1);
        }
        ans
    }
}
