impl Solution {
    pub fn min_k_bit_flips(nums: Vec<i32>, k: i32) -> i32 {
        let n = nums.len();
        let k = k as usize;
        let mut hint = vec![0i32; n];
        let mut flips = 0;
        let mut flip = 0;
        for i in 0..n {
            flip ^= hint[i];
            if (nums[i] ^ flip) == 0 {
                if i + k > n {
                    return -1;
                }
                flips += 1;
                flip ^= 1;
                if i + k < n {
                    hint[i + k] ^= 1;
                }
            }
        }
        flips
    }
}
