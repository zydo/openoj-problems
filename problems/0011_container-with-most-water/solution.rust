impl Solution {
    pub fn max_area(height: Vec<i32>) -> i64 {
        let mut left = 0usize;
        let mut right = height.len() - 1;
        let mut best = 0i64;
        while left < right {
            let h = height[left].min(height[right]);
            let area = (right - left) as i64 * h as i64;
            if area > best {
                best = area;
            }
            if height[left] < height[right] {
                left += 1;
            } else {
                right -= 1;
            }
        }
        best
    }
}
