impl Solution {
    pub fn triangle_number(nums: Vec<i32>) -> i32 {
        let mut sorted = nums;
        sorted.sort();
        let n = sorted.len();
        let mut count: i64 = 0;
        for i in (2..n).rev() {
            if sorted[i] == 0 {
                break;
            }
            let mut lo = 0usize;
            let mut hi = i - 1;
            while lo < hi {
                if sorted[lo] + sorted[hi] > sorted[i] {
                    count += (hi - lo) as i64;
                    hi -= 1;
                } else {
                    lo += 1;
                }
            }
        }
        count as i32
    }
}
