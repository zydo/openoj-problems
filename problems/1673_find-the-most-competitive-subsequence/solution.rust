impl Solution {
    pub fn most_competitive(nums: Vec<i32>, k: i32) -> Vec<i32> {
        let k = k as usize;
        let n = nums.len();
        let mut stack: Vec<i32> = Vec::with_capacity(k);
        for i in 0..n {
            let value = nums[i];
            let remaining = n - i;
            while let Some(&top) = stack.last() {
                if top > value && stack.len() + remaining > k {
                    stack.pop();
                } else {
                    break;
                }
            }
            if stack.len() < k {
                stack.push(value);
            }
        }
        stack
    }
}
