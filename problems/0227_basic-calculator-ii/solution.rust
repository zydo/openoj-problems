impl Solution {
    pub fn calculate(s: String) -> i32 {
        let bytes = s.as_bytes();
        let last = bytes.len() - 1;
        let mut stack: Vec<i64> = Vec::new();
        let mut num: i64 = 0;
        let mut op: u8 = b'+';
        for i in 0..=last {
            let ch = bytes[i];
            if ch.is_ascii_digit() {
                num = num * 10 + (ch - b'0') as i64;
            }
            if ch == b'+' || ch == b'-' || ch == b'*' || ch == b'/' || i == last {
                match op {
                    b'+' => stack.push(num),
                    b'-' => stack.push(-num),
                    b'*' => {
                        let top = stack.len() - 1;
                        stack[top] *= num;
                    }
                    _ => {
                        let top = stack.len() - 1;
                        stack[top] /= num;
                    }
                }
                op = ch;
                num = 0;
            }
        }
        stack.iter().sum::<i64>() as i32
    }
}
