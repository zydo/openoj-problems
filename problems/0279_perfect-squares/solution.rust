impl Solution {
    pub fn num_squares(n: i32) -> i32 {
        let n = n as usize;
        let mut squares: Vec<usize> = Vec::new();
        let mut i = 1usize;
        while i * i <= n {
            squares.push(i * i);
            i += 1;
        }
        let inf = n + 1;
        let mut dp = vec![inf; n + 1];
        dp[0] = 0;
        for i in 1..=n {
            for &s in &squares {
                if s > i {
                    break;
                }
                if dp[i - s] + 1 < dp[i] {
                    dp[i] = dp[i - s] + 1;
                }
            }
        }
        dp[n] as i32
    }
}
