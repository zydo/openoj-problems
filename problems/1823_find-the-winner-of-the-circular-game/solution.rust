impl Solution {
    pub fn find_the_winner(n: i32, k: i32) -> i32 {
        let n = n as usize;
        let k = k as usize;
        let mut friends: Vec<usize> = (1..=n).collect();
        let mut idx = 0usize;
        while friends.len() > 1 {
            idx = (idx + k - 1) % friends.len();
            friends.remove(idx);
        }
        friends[0] as i32
    }
}
