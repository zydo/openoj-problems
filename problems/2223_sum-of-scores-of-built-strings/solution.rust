impl Solution {
    pub fn sum_scores(s: String) -> i64 {
        let s = s.as_bytes();
        let n = s.len();
        if n == 0 {
            return 0;
        }
        let mut z = vec![0i64; n];
        z[0] = n as i64;
        let mut left = 0usize;
        let mut right = 0usize;
        for i in 1..n {
            if i < right {
                z[i] = (right - i) as i64;
                if z[i - left] < z[i] {
                    z[i] = z[i - left];
                }
            }
            while i + (z[i] as usize) < n && s[z[i] as usize] == s[i + z[i] as usize] {
                z[i] += 1;
            }
            if i + z[i] as usize > right {
                left = i;
                right = i + z[i] as usize;
            }
        }
        z.iter().sum()
    }
}
