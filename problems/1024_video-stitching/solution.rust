impl Solution {
    pub fn video_stitching(clips: Vec<Vec<i32>>, time: i32) -> i32 {
        let mut ordered = clips.clone();
        ordered.sort();
        let mut count = 0;
        let mut covered = 0;
        let mut farthest = 0;
        let mut i = 0usize;
        let n = ordered.len();
        while covered < time {
            while i < n && ordered[i][0] <= covered {
                if ordered[i][1] > farthest {
                    farthest = ordered[i][1];
                }
                i += 1;
            }
            if farthest == covered {
                return -1;
            }
            covered = farthest;
            count += 1;
        }
        count
    }
}
