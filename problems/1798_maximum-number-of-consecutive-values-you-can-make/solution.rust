impl Solution {
    pub fn get_maximum_consecutive(coins: Vec<i32>) -> i32 {
        let mut sorted = coins;
        sorted.sort_unstable();
        let mut reachable = 0i32;
        for coin in sorted {
            if coin > reachable + 1 {
                break;
            }
            reachable += coin;
        }
        reachable + 1
    }
}
