impl Solution {
    pub fn min_sub_array_len(target: i32, nums: Vec<i32>) -> i32 {
        let n = nums.len();
        let mut best = n + 1;
        let mut window: i64 = 0;
        let mut left = 0usize;
        for right in 0..n {
            window += nums[right] as i64;
            while window >= target as i64 {
                best = best.min(right - left + 1);
                window -= nums[left] as i64;
                left += 1;
            }
        }
        if best == n + 1 {
            0
        } else {
            best as i32
        }
    }
}
