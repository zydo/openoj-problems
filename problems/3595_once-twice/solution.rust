use std::collections::HashMap;

impl Solution {
    pub fn once_twice(nums: Vec<i32>) -> Vec<i32> {
        let mut counts: HashMap<i32, i32> = HashMap::new();
        for &x in &nums {
            *counts.entry(x).or_insert(0) += 1;
        }
        let mut once = 0;
        let mut twice = 0;
        for (&value, &count) in counts.iter() {
            if count == 1 {
                once = value;
            } else if count == 2 {
                twice = value;
            }
        }
        vec![once, twice]
    }
}
