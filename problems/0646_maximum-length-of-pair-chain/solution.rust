impl Solution {
    pub fn find_longest_chain(pairs: Vec<Vec<i32>>) -> i32 {
        let mut pairs = pairs;
        pairs.sort_by_key(|p| p[1]);
        let mut length = 0;
        let mut current_end = i64::MIN;
        for pair in &pairs {
            if (pair[0] as i64) > current_end {
                length += 1;
                current_end = pair[1] as i64;
            }
        }
        length
    }
}
