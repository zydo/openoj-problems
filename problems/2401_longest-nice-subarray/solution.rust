impl Solution {
    pub fn longest_nice_subarray(nums: Vec<i32>) -> i32 {
        let mut best = 1;
        let mut left = 0;
        let mut window_or: i32 = 0;
        for right in 0..nums.len() {
            let value = nums[right];
            while window_or & value != 0 {
                window_or ^= nums[left];
                left += 1;
            }
            window_or |= value;
            if right - left + 1 > best {
                best = right - left + 1;
            }
        }
        best as i32
    }
}
