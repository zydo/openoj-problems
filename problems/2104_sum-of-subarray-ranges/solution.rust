impl Solution {
    pub fn sub_array_ranges(nums: Vec<i32>) -> i64 {
        let n = nums.len();
        let mut total: i64 = 0;
        for i in 0..n {
            let mut mn = nums[i];
            let mut mx = nums[i];
            for j in i + 1..n {
                if nums[j] < mn {
                    mn = nums[j];
                } else if nums[j] > mx {
                    mx = nums[j];
                }
                total += (mx - mn) as i64;
            }
        }
        total
    }
}
