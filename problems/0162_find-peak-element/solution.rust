impl Solution {
    pub fn find_peak_element(nums: Vec<i32>) -> i32 {
        let n = nums.len();
        for i in 0..n {
            let left_ok = i == 0 || nums[i] > nums[i - 1];
            let right_ok = i == n - 1 || nums[i] > nums[i + 1];
            if left_ok && right_ok {
                return i as i32;
            }
        }
        -1
    }
}
