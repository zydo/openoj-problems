impl Solution {
    pub fn largest_number(nums: Vec<i32>) -> String {
        let mut strs: Vec<String> = nums.iter().map(|n| n.to_string()).collect();
        strs.sort_by(|a, b| format!("{}{}", b, a).cmp(&format!("{}{}", a, b)));
        let result = strs.concat();
        if result.starts_with('0') {
            "0".to_string()
        } else {
            result
        }
    }
}
